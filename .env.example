# PostgreSQL (required)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/projectmsg

# HTTP bind — use 0.0.0.0 so other machines on the LAN can open the UI/API
HOST=0.0.0.0
PORT=8800

# This machine's node identity (auto-generated into data/node.json if omitted)
# NODE_ID=
# NODE_NAME=My-PC
# NODE_ROLE=hub

# DeepSeek (optional; overrides DB settings when set)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_ENABLED=true

# Agent mode (other PCs): point at the hub and push local scan results
# HUB_URL=http://192.168.1.10:8800
# AGENT_TOKEN=
# SCAN_DEPTH=2
